{
  "name": "@perolanegra/sprite-fighter",
  "version": "0.1.0",
  "description": "Player de cenas de luta 2D roteirizadas a partir de poses-imagem (sem dependências). Entrada /authoring: conferência detalhada, schema, API fluente e debug.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./authoring": {
      "types": "./dist/authoring.d.ts",
      "import": "./dist/authoring.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -b"
  },
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Perolanegra/sprite-fighter.git",
    "directory": "packages/core"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
