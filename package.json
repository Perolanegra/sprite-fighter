{
  "name": "sprite-fighter-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/demo",
    "build": "npm run build -w packages/core && npm run build -w apps/demo && npm run build -w packages/cli && npm run build:ng",
    "test": "vitest run",
    "size": "node packages/core/bundle-size.mjs",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "shots": "node apps/demo/shots/shots.mjs",
    "atlas": "sf sheet",
    "pose:list": "sf pose:list",
    "pose:add": "sf pose:add",
    "narrate": "sf",
    "build:ng": "ng build ngx-sprite-fighter && ng build ng-example",
    "ng:start": "ng build ngx-sprite-fighter && ng serve ng-example",
    "ng:check": "node apps/ng-example/shots/check.mjs",
    "lab": "sf lab",
    "pack:all": "node scripts/pack-all.mjs"
  },
  "devDependencies": {
    "@angular/build": "~21.2.0",
    "@angular/cli": "~21.2.0",
    "@angular/common": "~21.2.0",
    "@angular/compiler": "~21.2.0",
    "@angular/compiler-cli": "~21.2.0",
    "@angular/core": "~21.2.0",
    "@angular/platform-browser": "~21.2.0",
    "@angular/router": "~21.2.0",
    "@types/node": "^22.19.0",
    "ng-packagr": "~21.2.0",
    "playwright": "^1.65.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.9.1",
    "typescript": "~5.9.3",
    "vite": "^8.3.8",
    "vitest": "4.1.12",
    "zone.js": "^0.16.3"
  },
  "overrides": {
    "vitest": "4.1.12",
    "@vitest/browser": "4.1.12",
    "@vitest/browser-playwright": "4.1.12",
    "@vitest/browser-preview": "4.1.12",
    "@vitest/browser-webdriverio": "4.1.12",
    "@vitest/coverage-istanbul": "4.1.12",
    "@vitest/coverage-v8": "4.1.12",
    "@vitest/ui": "4.1.12"
  }
}
