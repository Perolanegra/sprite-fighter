{
  "name": "sprite-fighter-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "tools/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/demo",
    "build": "npm run build -w packages/core -w tools/atlas -w tools/narrator -w apps/demo && npm run build:ng",
    "test": "vitest run",
    "size": "node packages/core/bundle-size.mjs",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "shots": "node apps/demo/shots/shots.mjs",
    "atlas": "npm run start -w tools/atlas --",
    "pose:list": "npm run start -w tools/atlas -- pose-list",
    "pose:add": "npm run start -w tools/atlas -- pose-add",
    "narrate": "node tools/narrator/dist/cli.js",
    "build:ng": "ng build ngx-sprite-fighter && ng build ng-example",
    "ng:start": "ng build ngx-sprite-fighter && ng serve ng-example",
    "ng:check": "node apps/ng-example/shots/check.mjs"
  },
  "devDependencies": {
    "@angular/build": "~22.2.7",
    "@angular/cli": "~22.2.7",
    "@angular/common": "~22.2.6",
    "@angular/compiler": "~22.2.6",
    "@angular/compiler-cli": "~22.2.6",
    "@angular/core": "~22.2.6",
    "@angular/platform-browser": "~22.2.6",
    "@angular/router": "~22.2.6",
    "@types/node": "^22.19.0",
    "ng-packagr": "~22.2.6",
    "playwright": "^1.65.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.9.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "zone.js": "^0.16.3"
  }
}
