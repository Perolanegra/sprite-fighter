{
  "title": "o agente persegue o neo pelos telhados",
  "seed": 5,
  "tail": 0.55,
  "cast": {
    "smith": { "at": [-620, 700], "scale": 0.32, "clip": "idle_fly" },
    "neo": { "at": [-150, 660], "scale": 0.32, "clip": "idle_fly" }
  },
  "camera": { "mode": "auto", "maxZoom": 0.6, "minZoom": 0.3, "margin": 110 },
  "steps": [
    { "id": "fuga", "at": 0, "actor": "neo", "do": "moveTo", "params": { "route": "M -150 660 C 350 560 950 700 1500 580", "duration": 2.3, "ease": "sineInOut" } },
    { "at": 0, "do": "fx", "params": { "type": "speedlines", "frames": 150, "intensity": 0.4 } },
    { "at": 0.05, "actor": "smith", "do": "moveTo", "params": { "route": "M -620 700 C -150 610 600 730 1290 620", "duration": 2.7, "ease": "sineInOut" } },

    { "id": "tiro1", "at": 0.75, "actor": "smith", "do": "move", "params": { "id": "shoot", "target": "neo" } },
    { "id": "tiro2", "at": 1.45, "actor": "smith", "do": "move", "params": { "id": "shoot", "target": "neo" } },
    { "on": "incoming:smith->neo", "nth": 1, "actor": "neo", "do": "move", "params": { "id": "dodge" } },
    { "on": "incoming:smith->neo", "nth": 2, "actor": "neo", "do": "move", "params": { "id": "dodge" } },

    { "id": "porta", "at": 1.75, "do": "spawnProp", "params": { "type": "door", "id": "door", "at": [1860, 320], "size": [56, 440], "appear": 0.25 } },
    { "at": 1.75, "do": "camera", "params": { "targets": ["neo", "smith", "door"] } },
    { "at": 2.2, "actor": "neo", "do": "pose", "params": { "name": "enter" } },
    { "id": "entra", "at": 2.28, "actor": "neo", "do": "enter", "params": { "prop": "door", "duration": 0.5, "ease": "cubicIn" } },
    { "id": "fecha", "after": "entra", "delay": 0.06, "do": "prop", "params": { "id": "door", "action": "close", "duration": 0.1 } },
    { "at": 2.75, "actor": "smith", "do": "moveTo", "params": { "to": { "prop": "door", "anchor": "opening", "offset": [300, 0] }, "align": "center", "duration": 0.7, "ease": "power2In" } },

    { "id": "splat", "on": "hit:door->smith", "actor": "smith", "do": "parallel", "params": { "steps": [
      { "do": "hover" },
      { "do": "pose", "params": { "name": "splat", "transition": "cut" } },
      { "do": "touch", "params": { "prop": "door", "gap": 6 } },
      { "do": "play", "params": { "clip": "splat", "fade": 0 } },
      { "do": "fx", "params": { "type": "impact_big", "dir": [-1, 0] } },
      { "do": "fx", "params": { "type": "hitstop", "frames": 9 } }
    ] } },
    { "id": "recuo", "after": "splat", "delay": 0.4, "actor": "smith", "do": "moveTo", "params": { "to": [-40, 0], "relative": true, "duration": 0.18, "ease": "backOut" } },
    { "after": "recuo", "actor": "smith", "do": "parallel", "params": { "steps": [
      { "do": "pose", "params": { "name": "fall" } },
      { "do": "play", "params": { "clip": "fall", "fade": 8 } },
      { "do": "fall", "params": { "vx": -90, "vy": -120 } }
    ] } }
  ]
}
